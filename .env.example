DJANGO_SECRET_KEY=coloca-aqui-una-clave-larga-y-privada
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
ACCOUNT_EMAIL_VERIFICATION=mandatory
# Segundos de inactividad antes de cerrar la sesión (30 minutos).
SESSION_COOKIE_AGE=1800

# Google OAuth: nunca publiques estos valores en el repositorio.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo de producción para verificación y recuperación de contraseña.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=BICSAN <no-reply@example.com>
