#!/bin/sh
# Rechaza los mensajes de commit que no siguen Conventional Commits.
# Se activa con: git config core.hooksPath .githooks

first_line=$(head -n 1 "$1")

# Git genera estos mensajes por su cuenta; se aceptan tal cual.
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,100}$'

if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  echo "Mensaje de commit no valido:" >&2
  echo "  $first_line" >&2
  echo "" >&2
  echo "Formato esperado: <tipo>(<alcance>): <descripcion>" >&2
  echo "Tipos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert" >&2
  echo "Ejemplo: feat(ui): agrega el nuevo logo" >&2
  echo "Mas detalles en CONTRIBUTING.md" >&2
  exit 1
fi
